classDiagram
    class Main {
        +main(args)
    }

    class Robot {
        -Command m_autonomousCommand
        -RobotContainer m_robotContainer
        +robotInit()
        +robotPeriodic()
        +autonomousInit()
        +teleopInit()
        +testInit()
    }

    class RobotContainer {
        -Drivetrain drivetrain
        +getAutonomousCommand() Command
        -configureBindings()
    }

    class Drivetrain {
        -BaseMotorController leftLead
        -BaseMotorController rightLead
        +setOutput(leftSpeed, rightSpeed)
        +periodic()
    }

    class DriveCommand {
        -Drivetrain drivetrain
        -DoubleSupplier leftSpeed
        -DoubleSupplier rightSpeed
        +initialize()
        +execute()
        +end(interrupted)
        +isFinished() boolean
    }

    class OI {
        +XboxController controller$
        +DoubleSupplier leftDriveSupplier$
        +DoubleSupplier rightDriveSupplier$
    }

    class Constants {
    }

    class OperatorConstants {
        +int kDriverControllerPort$
    }

    class RobotMap {
        +BaseMotorController leftDrive1$
        +BaseMotorController leftDrive2$
        +BaseMotorController rightDrive1$
        +BaseMotorController rightDrive2$
    }

    class BaseMotorController
    class VictorSPX
    class Command
    class SubsystemBase
    class TimedRobot
    class RobotBase

    Main ..> RobotBase : starts Robot
    Robot ..|> TimedRobot
    Robot *-- RobotContainer
    RobotContainer *-- Drivetrain
    RobotContainer ..> DriveCommand : sets default
    RobotContainer ..> RobotMap : gets lead motors
    RobotContainer ..> OI : gets suppliers
    DriveCommand --|> Command
    DriveCommand ..> Drivetrain : controls
    Drivetrain --|> SubsystemBase
    Drivetrain --> BaseMotorController : controls leads
    RobotMap ..> VictorSPX : creates
    RobotMap --> BaseMotorController : configures followers
    Constants *-- OperatorConstants